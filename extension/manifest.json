{
  "manifest_version": 3,
  "name": "Cookie Vault",
  "version": "1.5.0",
  "description": "Restore browser cookies from a JSON, Netscape (cookies.txt), or ZIP export. Everything runs locally — no data ever leaves your device.",
  "author": "REPLACE_WITH_YOUR_NAME",
  "homepage_url": "REPLACE_WITH_YOUR_REPO_OR_SITE_URL",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["cookies", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "incognito": "split",
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-vault@local.extension",
      "strict_min_version": "109.0"
    }
  }
}
